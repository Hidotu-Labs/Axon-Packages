--- a/tcc.c
+++ b/tcc.c
@@ -21,6 +21,9 @@
 #include "tcc.h"
+#if defined(__linux__)
+# include <sys/utsname.h>
+#endif
 #if ONE_SOURCE
 # include "libtcc.c"
 #endif
 #include "tcctools.c"
 
@@ -200,2 +203,18 @@
+static void print_version(void)
+{
+#if defined(__linux__)
+    struct utsname system;
+    size_t suffix_size = sizeof("Linux)\n") - 1;
+    size_t version_size = sizeof(version) - 1;
+    if (uname(&system) == 0 && !strcmp(system.sysname, "Ascension")
+            && version_size >= suffix_size
+            && !memcmp(version + version_size - suffix_size,
+                       "Linux)\n", suffix_size)) {
+        printf("%.*sAscension)\n", (int)(version_size - suffix_size), version);
+        return;
+    }
+#endif
+    printf("%s", version);
+}
 
 static void print_dirs(const char *msg, char **paths, int nb_paths)
@@ -308,1 +326,1 @@
-            printf("%s", version);
+            print_version();
